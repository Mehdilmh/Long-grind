# LongGrind environment configuration
# Copy to .env.local for development. Every value here is a PLACEHOLDER.
# Never commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.

# --- Site ---------------------------------------------------------------
# Canonical origin used for metadata, sitemap and structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://longgrind.com

# Public contact email shown on /contact. Leave empty until the owner supplies a real, monitored address.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Amazon Associates ----------------------------------------------------
# Default marketplace key (see src/config/affiliate.ts). Currently supported: US
AMAZON_DEFAULT_MARKETPLACE=US
# Tracking ID for Amazon.com. Tracking IDs are not secret, but keep them configurable.
AMAZON_ASSOCIATE_TAG_US=gettse00-20

# Optional, server-only. Only fill these in if you have been approved for the official
# Amazon Creators API (or another approved product data source) and have implemented it
# following its current usage, attribution, refresh and caching rules. Not used by default.
AMAZON_CREATORS_API_CREDENTIAL_ID=
AMAZON_CREATORS_API_CREDENTIAL_SECRET=

# --- Analytics (optional, privacy-conscious) -------------------------------
# Plausible-compatible, cookieless analytics. Leave empty to load no analytics at all.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=https://plausible.io/js/script.js

# --- Search / social verification (optional) --------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_DOMAIN_VERIFY=

# --- Newsletter (optional) -----------------------------------------------
# The signup form renders ONLY when a real provider endpoint is configured,
# e.g. a Buttondown/ConvertKit/etc. hosted form action URL.
NEXT_PUBLIC_NEWSLETTER_FORM_ACTION=
NEXT_PUBLIC_NEWSLETTER_PROVIDER_NAME=

# --- Editorial ------------------------------------------------------------
# Set to "true" to render draft/review articles locally (always noindex; never in sitemap).
SHOW_DRAFTS=false
