    "@types/react": "19.1",
    "@types/react-dom": "19.1",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.29",
    "satori": "^0.18.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "next": "^15.5.27",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "zod": "^3.25.76"
