{
  "name": "longgrind",
  "version": "0.1.0",
  "private": true,
  "description": "LongGrind.com — gear for the long game. Editorial affiliate publication about desk setups and productivity gear.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:check": "tsx scripts/check-content.ts",
    "links:check": "tsx scripts/check-links.ts",
    "brand:png": "tsx scripts/build-brand-png.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run content:check"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
